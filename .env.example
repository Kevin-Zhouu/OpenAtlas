# Optional fallback; keys can also be saved in web Settings. Keep .env private.
OPENAI_API_KEY=
# The local default only listens on this machine.
OPENATLAS_BIND=127.0.0.1
OPENATLAS_ALLOWED_HOSTS=localhost,127.0.0.1
OPENATLAS_ACCESS_TOKEN=
OPENATLAS_SKILLS_DIR=./skills
# Only override if the Docker daemon uses a different internal socket path.
OPENATLAS_DOCKER_SOCKET=/var/run/docker.sock
OPENATLAS_JOB_TIMEOUT=1800
